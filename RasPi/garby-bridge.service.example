[Unit]
Description=GARBY LiDAR, BLE, sensor, and Firebase bridge
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=garby
# video: vcgencmd throttle flags via /dev/vcio. dialout: LiDAR and sensor UART.
SupplementaryGroups=video dialout
WorkingDirectory=/home/garby/GARBY/RasPi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/default/garby-bridge
ExecStartPre=/bin/bash /home/garby/GARBY/RasPi/run_bridge.sh --check-runtime
# Headless with a saved daily log (~/garby-logs) and the status file the
# launcher's `status` reads. The phone app is the monitor and the controls.
ExecStart=/bin/bash /home/garby/GARBY/RasPi/run_headless.sh run
Restart=always
RestartSec=10
TimeoutStopSec=10
KillSignal=SIGTERM
KillMode=control-group

[Install]
WantedBy=multi-user.target
