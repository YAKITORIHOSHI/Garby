[Unit]
Description=GARBY Raspberry Pi LiDAR/BLE safety bridge
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=garby
WorkingDirectory=/home/garby/GARBY/RasPi
EnvironmentFile=-/home/garby/GARBY/garby.env
ExecStart=/usr/bin/python3 /home/garby/GARBY/RasPi/final_w_serial.py --headless
Restart=always
RestartSec=2
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
