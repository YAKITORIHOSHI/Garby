[Unit]
Description=GARBY LiDAR, BLE, sensor, and Firebase bridge
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=garby
WorkingDirectory=/home/garby/GARBY/RasPi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/garby-bridge
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec /usr/bin/python3 /home/garby/GARBY/RasPi/final_w_serial.py --headless'
Restart=always
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
