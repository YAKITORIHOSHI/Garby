# Copy to /etc/default/garby-bridge and replace deployment-specific values.
GARBY_ROS_SETUP=/opt/ros/humble/setup.bash
GARBY_LIDAR_WORKSPACE_SETUP=/home/garby/ros2_ws/install/setup.bash
GARBY_PYTHON_BIN=/usr/bin/python3
# Shared by production, simulator, and the BLE connection probe.
GARBY_RUNTIME_LOCK_FILE=/tmp/garby-bridge.lock
# Optional persistent emergency-stop state (default ~/.config/garby/operator-stop).
# Use the same file for desktop and service users; the runtime user needs write access.
# GARBY_OPERATOR_STOP_FILE=/home/garby/.config/garby/operator-stop
# Linux adapter; leave the address unset for service-UUID/name discovery.
GARBY_BLE_ADAPTER=hci0
# GARBY_BLE_ADDRESS=AA:BB:CC:DD:EE:FF
# Optional: otherwise discover the service-account JSON in RasPi/Firebase/.
# Relative paths are resolved beside final_w_serial.py, independent of CWD.
# GARBY_FIREBASE_CREDENTIALS=Firebase/service-account.json
GARBY_FIREBASE_DATABASE_URL=https://garby-thesis-default-rtdb.asia-southeast1.firebasedatabase.app
# The LiDAR and sensor board are found by the data they send, on any port. Setting
# a port here turns detection off for that device and is only needed for a device
# that does not stream on its own.
# GARBY_SENSOR_SERIAL_PORT=/dev/ttyAMA0
# GARBY_LIDAR_PORT=/dev/serial/by-id/replace-with-ydlidar-id
GARBY_SENSOR_SERIAL_BAUD=9600
GARBY_LIDAR_BAUDRATE=115200
GARBY_LIDAR_DTR=false
# 0: every point of a revolution keeps its own angle. 1 lets the SDK cut each scan to a
# rounded startup size (it dropped 6-7 X3 points per scan on 2026-11-12).
GARBY_LIDAR_FIXED_RESOLUTION=0
GARBY_LIDAR_DRIVER_LOGS=0
# Set only after physically verifying the LiDAR mounting orientation.
GARBY_LIDAR_YAW_OFFSET_DEG=0
# Owner-reported LEFT/RIGHT reversal: reflect the lateral robot coordinate after yaw.
# Use 0 only for an alternate mount verified to need the previous orientation.
GARBY_LIDAR_REFLECT_LEFT_RIGHT=1
# Chassis outline relative to the LiDAR (hallway_geometry.py), in cm. Defaults: a
# 60 cm wide body with the LiDAR at the centre of 60 x 60 cm. Only the width is the
# owner's figure; measure the rest (docs/navigation-2026-11-11.md, calibration 6-7).
# GARBY_CHASSIS_WIDTH_CM=60
# GARBY_CHASSIS_FRONT_CM=30      # LiDAR to the front edge
# GARBY_CHASSIS_REAR_CM=30       # LiDAR to the rear edge
# GARBY_LIDAR_Y_OFFSET_CM=0      # LiDAR left (+) of the chassis centreline
# GARBY_ROTATION_X_CM=0          # spin centre (axle midpoint) ahead (+) of the LiDAR
