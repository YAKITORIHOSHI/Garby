# Copy to /etc/default/garby-bridge and replace deployment-specific values.
GARBY_FIREBASE_CREDENTIALS=/home/garby/GARBY/service-account.json
GARBY_FIREBASE_DATABASE_URL=https://garby-thesis-default-rtdb.asia-southeast1.firebasedatabase.app
GARBY_SENSOR_SERIAL_PORT=/dev/ttyAMA0
GARBY_SENSOR_SERIAL_BAUD=9600
GARBY_LIDAR_PORT=/dev/serial/by-id/replace-with-ydlidar-id
GARBY_LIDAR_BAUDRATE=115200
GARBY_LIDAR_DTR=false
GARBY_LIDAR_DRIVER_LOGS=0
# Set only after physically verifying the LiDAR mounting orientation.
GARBY_LIDAR_YAW_OFFSET_DEG=0
