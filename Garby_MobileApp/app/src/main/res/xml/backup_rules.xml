<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 (the manifest's allowBackup="false" already disables backup there). Kept
     explicit so no future flag change can start backing up the anonymous Firebase session. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
