+      valid ? lroundf(f.rearHeading * 100.0f) : 0L);
+  if (used <= 0 || (size_t)used >= sizeof(payload)) return false;
+  const int total = snprintf(out, size, "%s*%02X", payload, (unsigned)lineChecksum(payload));
+  return total > 0 && (size_t)total < size;
